# TEMPLATE ONLY. Generate unique secrets with scripts/generate-env.mjs.
# Never use defaults from another Supabase instance or commit a populated copy.
# Stable, lowercase, unique per stack; also used to namespace Traefik router names.
INSTANCE_ID=ngwanam-supabase
# DNS hostnames ONLY (no scheme/path); both must point to this VPS.
API_DOMAIN=api.example.com
STUDIO_DOMAIN=studio.example.com
# Public HTTPS website URL and exact comma-separated Auth redirect URLs.
SITE_URL=https://app.example.com
ADDITIONAL_REDIRECT_URLS=https://app.example.com/auth/confirm,https://app.example.com/update-password
# Network/entrypoint/resolver must match the existing Dokploy Traefik installation.
TRAEFIK_NETWORK=dokploy-network
TRAEFIK_ENTRYPOINT=websecure
TRAEFIK_CERT_RESOLVER=letsencrypt
# REQUIRED: your admin public IP/CIDR (comma-separated). No allow-all ranges.
# With a CDN/proxy, configure trusted forwarded IPs correctly first; see README.
STUDIO_ALLOWED_CIDRS=
# Generated 64-character hex password, unique per database; URI-safe.
POSTGRES_PASSWORD=
# Generated 64-character hex HS256 signing secret and matching legacy API JWTs.
JWT_SECRET=
ANON_KEY=
SERVICE_ROLE_KEY=
# Token lifetime for user sessions (seconds). Key rotation is a separate operation.
JWT_EXPIRY=3600
# Studio HTTP Basic Auth. Generated username is admin; password is random.
DASHBOARD_USERNAME=admin
DASHBOARD_PASSWORD=
# Internal encryption keys: 96-char hex, exactly 16 chars, 64-char hex respectively.
SECRET_KEY_BASE=
REALTIME_DB_ENC_KEY=
PG_META_CRYPTO_KEY=
# Studio labels; these are not authentication credentials.
STUDIO_DEFAULT_ORGANIZATION=NgWanam
STUDIO_DEFAULT_PROJECT=NgWanam Production
# Match existing app: email/password enabled, email verification deferred.
DISABLE_SIGNUP=false
ENABLE_EMAIL_AUTOCONFIRM=false
# Optional SMTP. Leave blank if mail is intentionally unavailable.
# No fake mail service is deployed. Recovery/invitation email requires real SMTP.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_ADMIN_EMAIL=
SMTP_SENDER_NAME=NgWanam

# Apply 20261105010000_google_identity_guards.sql BEFORE enabling Google.
# Add https://YOUR_APP_DOMAIN/auth/google/callback to ADDITIONAL_REDIRECT_URLS.
GOOGLE_AUTH_ENABLED=false
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
