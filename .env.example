NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Server-only; required for administrator-created local accounts. Never prefix NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=

# Server-only Google Gemini support. Never prefix NEXT_PUBLIC_ or commit a key.
# An empty key keeps saved FAQ and authenticated order lookups working.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
# Set false to disable external AI calls without disabling support.
GEMINI_ENABLED=true

# Google login is opt-in. Apply the identity-guard migration BEFORE enabling.
# OAuth client secret belongs only in the Supabase Auth service, not this app.
GOOGLE_AUTH_ENABLED=false
AUTH_SITE_URL=https://app.example.com
